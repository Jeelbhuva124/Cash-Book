    <!-- Page 15: Database Design -->
    <div class="page">
        <div class="page-header">Cash-Book: Smart Finance &amp; Digital Ledger</div>
        
        <div class="title-box">8. Database Design</div>
        
        <div class="db-title">❖ Collection Name: User</div>
        <table class="table-db">
            <thead>
                <tr>
                    <th>Field Name</th>
                    <th>Data Type</th>
                    <th>Constraints</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>username</td><td>String</td><td>Required, Trimmed</td><td>User's display name</td></tr>
                <tr><td>email_id</td><td>String</td><td>Required, Unique</td><td>User's email (Primary key identifier)</td></tr>
                <tr><td>password</td><td>String</td><td>Required</td><td>Hashed password</td></tr>
                <tr><td>mobile</td><td>String</td><td>Required</td><td>Contact number</td></tr>
                <tr><td>role</td><td>String</td><td>Enum: [0, 1]</td><td>0 = Admin, 1 = User</td></tr>
            </tbody>
        </table>

        <div class="db-title">❖ Collection Name: Transaction</div>
        <table class="table-db">
            <thead>
                <tr>
                    <th>Field Name</th>
                    <th>Data Type</th>
                    <th>Constraints</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>title</td><td>String</td><td>Required</td><td>Title of transaction</td></tr>
                <tr><td>type</td><td>String</td><td>Required (income/expense)</td><td>Transaction type</td></tr>
                <tr><td>amount</td><td>Number</td><td>Required</td><td>Transaction value</td></tr>
                <tr><td>date</td><td>String</td><td>Required</td><td>Date (YYYY-MM-DD)</td></tr>
                <tr><td>chalan_id</td><td>String</td><td>Required</td><td>Links to a Cashbook</td></tr>
                <tr><td>category</td><td>String</td><td>Default: ''</td><td>Transaction category</td></tr>
                <tr><td>user_email</td><td>String</td><td>Required</td><td>Email of the user who made it</td></tr>
                <tr><td>party_type</td><td>String</td><td>Enum: [creditor, debtor]</td><td>For party ledger entries</td></tr>
            </tbody>
        </table>

        <div class="db-title">❖ Collection Name: Cashbook</div>
        <table class="table-db">
            <thead>
                <tr>
                    <th>Field Name</th>
                    <th>Data Type</th>
                    <th>Constraints</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>chalan_id</td><td>String</td><td>Required, Unique</td><td>Unique ID of the cashbook</td></tr>
                <tr><td>chalan_name</td><td>String</td><td>Required</td><td>Display name of cashbook</td></tr>
                <tr><td>user_email</td><td>String</td><td>Required</td><td>Owner's email</td></tr>
            </tbody>
        </table>

        <div class="footer-line" style="position: static;"></div>
        <div class="page-number" style="position: static;">13</div>
    </div>
    
    <!-- Page 16: Database Design Cont -->
    <div class="page">
        <div class="page-header">Cash-Book: Smart Finance &amp; Digital Ledger</div>

        <div class="db-title">❖ Collection Name: Invitation</div>
        <table class="table-db">
            <thead>
                <tr>
                    <th>Field Name</th>
                    <th>Data Type</th>
                    <th>Constraints</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>invite_name</td><td>String</td><td>Required</td><td>Name of the invitee</td></tr>
                <tr><td>invite_email</td><td>String</td><td>Required</td><td>Email of the invited user</td></tr>
                <tr><td>inviter_email</td><td>String</td><td>Required</td><td>Email of the user sending invite</td></tr>
                <tr><td>cashbook_id</td><td>String</td><td>Required</td><td>The cashbook being shared</td></tr>
                <tr><td>status</td><td>String</td><td>Enum: [pending, accepted, rejected]</td><td>Current status of invite</td></tr>
            </tbody>
        </table>
        
        <div class="db-title">❖ Collection Name: Receipt</div>
        <table class="table-db">
            <thead>
                <tr>
                    <th>Field Name</th>
                    <th>Data Type</th>
                    <th>Constraints</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>title</td><td>String</td><td>Required</td><td>Description of the receipt</td></tr>
                <tr><td>file_url</td><td>String</td><td>Required</td><td>URL/Base64 of the receipt image</td></tr>
                <tr><td>user_email</td><td>String</td><td>Required</td><td>Owner's email</td></tr>
                <tr><td>date</td><td>String</td><td>Required</td><td>Date of upload</td></tr>
            </tbody>
        </table>
        
        <div class="footer-line" style="position: static;"></div>
        <div class="page-number" style="position: static;">14</div>
    </div>

